<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="MyAutomaticCarWashWithDiesel" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <storeData>
        <name>$l10n_staffedWorkshop</name>
        <functions>
            <function>$l10n_staffedWorkshopFunction-s</function>
        </functions>
        <image>store/store_pitStop.dds</image>
        <price>30000</price>
        <dailyUpkeep>4000</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <species>PLACEABLE</species>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>tools</tab>
        </brush>
        <brand>FARMERTOOLS</brand>
        <category>placeableMisc</category>
    </storeData>

    <base>
        <filename>models/pitStop.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="3" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <!-- <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/> -->
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <triggerMarkers>
        <triggerMarker node="warningStripes"/>
        <triggerMarker node="loadingMarker" filename="$data/shared/assets/marker/markerIconLoad.i3d" />
        <triggerMarker node="refillMarker"  filename="$data/shared/assets/marker/markerIconWrench.i3d" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="SHOP" linkNode="vehicleTrigger" teleportNode="refillMarker"/>
    </hotspots>

    <infoTrigger triggerNode="infoTrigger"/>

    <automaticCarWash triggerNode="vehicleTrigger" dirtAmount="-0.15"  damageAmount="-0.1"  wearAmount="0" >
        <animatedObjects>
            <animatedObject type="LastVehicleLeftTrigger" index="1" direction="0" />
            <animatedObject type="AllVehiclesInTriggerDone" index="1" direction="1" />
            <animatedObject type="VehicleEnterTrigger" index="2" direction="1" />
            <animatedObject type="LastVehicleLeftTrigger" index="2" direction="0" />
        </animatedObjects>
    </automaticCarWash>

    <animatedObjects>
        <animatedObject saveId="barrier1" >
            <animation duration="3">
                <!-- green light -->
                <part node="0>6|0|3|0|2">
                    <keyFrame time="0.99" visibility="false"/>
                    <keyFrame time="1.00" visibility="true"/>
                </part>

                <part node="0>6|0|3|0|3">
                    <keyFrame time="0.99" visibility="false"/>
                    <keyFrame time="1.00" visibility="true"/>
                </part>

                <!-- red light -->
                <part node="0>6|0|3|0|0">
                    <keyFrame time="0.99" visibility="true"/>
                    <keyFrame time="1.00" visibility="false"/>
                </part>

                <part node="0>6|0|3|0|1">
                    <keyFrame time="0.99" visibility="true"/>
                    <keyFrame time="1.00" visibility="false"/>
                </part>
                <part node="blockFront">
                    <keyFrame time="0.0" translation="0 1.5 0" rotation="0 0 0"/>
                    <keyFrame time="1.0" translation="0 -1.5 0" rotation="0 0 0"/>
                </part>
            </animation>
        </animatedObject>
        <animatedObject saveId="barrier2" >
            <animation duration="0.5">
                <part node="blockBack">
                    <keyFrame time="0.0" translation="12 -1.5 0" rotation="0 0 0"/>
                    <keyFrame time="1.0" translation="12 1.5 0" rotation="0 0 0"/>
                </part>
            </animation>
        </animatedObject>
    </animatedObjects>

    <silo playerActionTrigger="refillPlayerTrigger" sellWarningText="$l10n_info_tankNotEmpty">
        <loadingStation node="loadingTrigger" supportsExtension="false">
            <loadTrigger triggerNode="loadingTrigger" fillTypes="DIESEL" fillLitersPerSecond="20" dischargeNode="dischargeNode" startFillText="$l10n_action_refuel" stopFillText="$l10n_action_stopRefuel" autoStart="true"/>
        </loadingStation>

        <unloadingStation supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" fillTypes="DIESEL"/>
        </unloadingStation>

        <storages>
            <storage node="storage" fillTypes="DIESEL" capacity="10000" isExtension="false">
                <startFillLevel fillType="DIESEL" fillLevel="0" />
            </storage>
        </storages>
    </silo>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="testAreaStart01" node="0>3|0" />
        <i3dMapping id="testAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>4|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="warningStripes" node="0>5|0" />
        <i3dMapping id="vehicleTrigger" node="0>5|1" />
        <i3dMapping id="blockFront" node="0>6|1|0" />
        <i3dMapping id="blockBack" node="0>6|1|1" />

        <i3dMapping id="exactFillRootNode" node="0>7|0|0" />
        <i3dMapping id="loadingTrigger" node="0>7|1|0" />
        <i3dMapping id="dischargeNode" node="0>7|1|1" />
        <i3dMapping id="loadingMarker" node="0>7|1|2" />
        <i3dMapping id="refillPlayerTrigger" node="0>7|2" />
        <i3dMapping id="refillMarker" node="0>7|2|0" />
        <i3dMapping id="storage" node="0>7|3" />
        <i3dMapping id="infoTrigger" node="0>7|5" />
    </i3dMappings>
</placeable>